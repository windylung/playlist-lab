# === 필수 (Supabase) ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === 필수 (API 보안) ===
SURVEY_API_KEY=change-me-to-a-long-random-string
PORT=8787

ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,null

# === Google Sheets 동기화 ===
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=응답
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
# Vercel 배포 시 파일 대신 base64 한 줄 사용:
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# 로컬 Express 전용 (Vercel에서는 미사용, 제출 직후 즉시 동기화)
SHEET_SYNC_INTERVAL_MS=30000
